<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- 记录时间 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/record_time"
            android:textSize="@dimen/text_size_large"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_normal" />

        <androidx.cardview.widget.CardView
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_large"
                android:textSize="@dimen/text_size_xlarge"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <!-- 尿量 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/urine_volume"
            android:textSize="@dimen/text_size_large"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_normal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_large">

            <androidx.cardview.widget.CardView
                android:id="@+id/volume_low"
                style="@style/AppCard"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:strokeColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@android:drawable/arrow_down_float"
                        android:tint="@color/primary"
                        android:contentDescription="少量" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_low"
                        android:textSize="@dimen/text_size_large"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/spacing_small" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/volume_medium"
                style="@style/AppCard"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:strokeColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@android:drawable/arrow_down_float"
                        android:tint="@color/primary"
                        android:contentDescription="中量" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_medium"
                        android:textSize="@dimen/text_size_large"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/spacing_small" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/volume_high"
                style="@style/AppCard"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:strokeColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@android:drawable/arrow_down_float"
                        android:tint="@color/primary"
                        android:contentDescription="大量" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/volume_high"
                        android:textSize="@dimen/text_size_large"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="@dimen/spacing_small" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- 症状 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/symptoms"
            android:textSize="@dimen/text_size_large"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_normal" />

        <androidx.cardview.widget.CardView
            style="@style/AppCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_leakage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/has_leakage"
                    android:textSize="@dimen/text_size_large"
                    android:paddingVertical="@dimen/spacing_small" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_urgency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/has_urgency"
                    android:textSize="@dimen/text_size_large"
                    android:paddingVertical="@dimen/spacing_small" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_pain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/has_pain"
                    android:textSize="@dimen/text_size_large"
                    android:paddingVertical="@dimen/spacing_small" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_weak_stream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/has_weak_stream"
                    android:textSize="@dimen/text_size_large"
                    android:paddingVertical="@dimen/spacing_small" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_intermittent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/has_intermittent"
                    android:textSize="@dimen/text_size_large"
                    android:paddingVertical="@dimen/spacing_small" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_nocturia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/is_nocturia"
                    android:textSize="@dimen/text_size_large"
                    android:paddingVertical="@dimen/spacing_small" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 备注 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/note"
            android:textSize="@dimen/text_size_large"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_normal" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xlarge">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textSize="@dimen/text_size_large"
                android:paddingVertical="@dimen/spacing_normal"
                android:hint="选填，记录其他情况" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 保存按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/AppButton.Large"
            android:layout_width="match_parent"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
