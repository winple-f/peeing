<view class="container">
  <text class="page-title">选择导出范围</text>

  <view class="card">
    <radio-group bindchange="onRangeChange">
      <label class="radio-item">
        <radio value="0" checked="{{exportRange === 0}}" />
        <text>全部数据</text>
      </label>
      <label class="radio-item">
        <radio value="1" checked="{{exportRange === 1}}" />
        <text>最近30天</text>
      </label>
      <label class="radio-item">
        <radio value="2" checked="{{exportRange === 2}}" />
        <text>最近90天</text>
      </label>
    </radio-group>
  </view>

  <button class="btn-export" bindtap="handleExport">导出为Excel文件</button>

  <text class="export-hint">导出的文件会保存在手机的文档文件夹中，您可以通过微信等方式发送给医生。</text>
</view>
