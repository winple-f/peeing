.container {
  padding: 32rpx;
  padding-bottom: 160rpx;
}

.summary-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.summary-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: 32rpx;
  color: #757575;
}

.summary-value {
  font-size: 32rpx;
  color: #212121;
  font-weight: bold;
}

.export-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 24rpx;
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.checkbox {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #BDBDBD;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #4CAF50;
  border-color: #4CAF50;
}

.check-mark {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}

.checkbox-label {
  font-size: 32rpx;
  color: #424242;
}

.preview-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.preview-scroll {
  width: 100%;
  white-space: nowrap;
}

.preview-content {
  display: inline-block;
  min-width: 100%;
}

.preview-text {
  font-size: 24rpx;
  color: #616161;
  font-family: monospace;
  white-space: pre;
  line-height: 1.8;
}

.btn-generate {
  background: #4CAF50;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.btn-copy {
  background: #2196F3;
  color: #FFFFFF;
  font-size: 36rpx;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
}
