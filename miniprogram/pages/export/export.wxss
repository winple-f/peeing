.container {
  padding: 32rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 32rpx;
  display: block;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  font-size: 36rpx;
  color: #212121;
  border-bottom: 1rpx solid #E0E0E0;
}

.radio-item:last-child {
  border-bottom: none;
}

.radio-item radio {
  transform: scale(1.2);
  margin-right: 20rpx;
}

.btn-export {
  width: 100%;
  background: #2196F3;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.export-hint {
  font-size: 30rpx;
  color: #757575;
  line-height: 1.6;
  display: block;
}
