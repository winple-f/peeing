<view class="container">
  <text class="section-title">记录时间</text>
  <view class="time-card" bindtap="pickTime">
    <text class="time-text">{{recordTime}}</text>
  </view>

  <text class="section-title">尿量</text>
  <view class="volume-row">
    <view class="volume-card {{volumeLevel === 0 ? 'selected' : ''}}" bindtap="selectVolume" data-level="0">
      <text class="volume-icon">↓</text>
      <text class="volume-text">少量</text>
    </view>
    <view class="volume-card {{volumeLevel === 1 ? 'selected' : ''}}" bindtap="selectVolume" data-level="1">
      <text class="volume-icon">↓</text>
      <text class="volume-text">中量</text>
    </view>
    <view class="volume-card {{volumeLevel === 2 ? 'selected' : ''}}" bindtap="selectVolume" data-level="2">
      <text class="volume-icon">↓</text>
      <text class="volume-text">大量</text>
    </view>
  </view>

  <text class="section-title">症状</text>
  <view class="symptoms-card">
    <view class="symptom-item" wx:for="{{symptoms}}" wx:key="key" wx:for-item="symptom">
      <view class="symptom-header" bindtap="toggleSymptom" data-index="{{index}}">
        <view class="checkbox {{symptom.checked ? 'checked' : ''}}"></view>
        <text class="symptom-label">{{symptom.label}}</text>
      </view>
      <view class="slider-area" wx:if="{{symptom.checked}}">
        <text class="slider-label">严重程度</text>
        <view class="slider-row">
          <text class="slider-bound">1</text>
          <slider class="severity-slider" min="1" max="3" value="{{symptom.score}}" step="1" block-size="28" activeColor="#2196F3" bindchange="onScoreChange" data-index="{{index}}" />
          <text class="slider-bound">3</text>
          <text class="score-display">{{symptom.score}}分</text>
        </view>
      </view>
    </view>
  </view>

  <text class="section-title">备注</text>
  <textarea class="note-input" placeholder="选填，记录其他情况" value="{{note}}" bindinput="onNoteInput" />

  <button class="btn-save" bindtap="handleSave">保存</button>
</view>
