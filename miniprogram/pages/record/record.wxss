.container {
  padding: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 20rpx;
  display: block;
}

.time-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.time-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #2196F3;
}

.volume-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.volume-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 4rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.volume-card.selected {
  border-color: #2196F3;
  background: #E3F2FD;
}

.volume-icon {
  font-size: 48rpx;
  color: #2196F3;
  margin-bottom: 8rpx;
}

.volume-text {
  font-size: 34rpx;
  color: #212121;
}

.symptoms-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.symptom-item {
  border-bottom: 1rpx solid #E0E0E0;
}

.symptom-item:last-child {
  border-bottom: none;
}

.symptom-header {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #BDBDBD;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #2196F3;
  border-color: #2196F3;
}

.symptom-label {
  font-size: 36rpx;
  color: #212121;
}

.slider-area {
  padding-left: 60rpx;
  padding-bottom: 16rpx;
}

.slider-label {
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 8rpx;
}

.slider-row {
  display: flex;
  align-items: center;
}

.slider-bound {
  font-size: 28rpx;
  color: #757575;
  width: 30rpx;
  text-align: center;
  flex-shrink: 0;
}

.severity-slider {
  flex: 1;
  margin: 0 16rpx;
}

.score-display {
  font-size: 28rpx;
  color: #2196F3;
  font-weight: bold;
  width: 60rpx;
  flex-shrink: 0;
}

.note-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 36rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #E0E0E0;
  margin-bottom: 32rpx;
}

.btn-save {
  width: 100%;
  background: #2196F3;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
}
