.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: #F5F5F5;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 8rpx;
}

.app-desc {
  font-size: 30rpx;
  color: #757575;
}

.intro-area {
  width: 100%;
  margin-bottom: 60rpx;
  padding: 40rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.intro-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.intro-item:last-child {
  margin-bottom: 0;
}

.intro-icon {
  width: 56rpx;
  height: 56rpx;
  background: #2196F3;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.intro-text {
  font-size: 34rpx;
  color: #424242;
}

.btn-area {
  width: 100%;
  margin-top: auto;
  position: fixed;
  bottom: 60rpx;
  left: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.btn-primary {
  background: #2196F3;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: bold;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  width: 100%;
  border: none;
  line-height: 1.5;
}

.privacy-text {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #9E9E9E;
  margin-top: 20rpx;
}
