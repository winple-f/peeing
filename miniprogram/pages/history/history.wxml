<view class="container">
  <view class="tabs">
    <view class="tab-item {{activeTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">排尿记录</view>
    <view class="tab-item {{activeTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">量表评估</view>
  </view>

  <view wx:if="{{activeTab === 0}}">
    <view wx:if="{{urinationRecords.length > 0}}">
      <view class="record-card" wx:for="{{urinationRecords}}" wx:key="id">
        <view class="record-header">
          <text class="record-time">{{item.timeText}}</text>
          <text class="record-volume">{{item.volumeText}}</text>
        </view>
        <text class="record-symptoms">{{item.symptomsText}}</text>
      </view>
    </view>
    <view wx:else class="empty-text">暂无记录</view>
  </view>

  <view wx:if="{{activeTab === 1}}">
    <view wx:if="{{surveyRecords.length > 0}}">
      <view class="record-card" wx:for="{{surveyRecords}}" wx:key="id">
        <view class="record-header">
          <text class="record-time">{{item.timePoint}}</text>
          <text class="record-date">{{item.dateText}}</text>
        </view>
        <text class="record-detail">ICIQ-SF：{{item.iciqTotalScore}}分</text>
        <text class="record-detail">IPSS：{{item.ipssTotalScore}}分（{{item.severity}}）</text>
        <text class="record-detail">QoL：{{item.qolScore}}分</text>
      </view>
    </view>
    <view wx:else class="empty-text">暂无记录</view>
  </view>
</view>
