.container {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.tab-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 36rpx;
  color: #9E9E9E;
}

.tab-item.active {
  color: #2196F3;
  font-weight: bold;
  border-bottom: 6rpx solid #2196F3;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #BDBDBD;
  font-size: 32rpx;
}

.record-group {
  margin-bottom: 32rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
}

.group-date {
  font-size: 34rpx;
  font-weight: bold;
  color: #424242;
}

.group-count {
  font-size: 28rpx;
  color: #9E9E9E;
}

.record-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-time {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
}

.record-volume {
  font-size: 32rpx;
  color: #4CAF50;
  font-weight: bold;
  background: #E8F5E9;
  padding: 4rpx 24rpx;
  border-radius: 8rpx;
}

.record-symptoms {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.symptom-tag {
  font-size: 26rpx;
  color: #FF9800;
  background: #FFF3E0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.record-scores {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.score-item {
  font-size: 26rpx;
  color: #795548;
}

.record-note {
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 12rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid #F0F0F0;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.action-delete {
  font-size: 28rpx;
  color: #F44336;
}

.survey-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.survey-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.survey-type {
  font-size: 36rpx;
  font-weight: bold;
  color: #2196F3;
}

.survey-date {
  font-size: 28rpx;
  color: #9E9E9E;
}

.survey-score-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.survey-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
}

.survey-label {
  font-size: 32rpx;
  color: #FF9800;
  font-weight: bold;
}
