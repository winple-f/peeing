.container {
  padding: 24rpx;
}

.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 34rpx;
  color: #757575;
}

.tab-item.active {
  color: #2196F3;
  font-weight: bold;
  border-bottom: 4rpx solid #2196F3;
}

.record-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  flex: 1;
}

.record-volume {
  font-size: 30rpx;
  color: #2196F3;
  background: #E3F2FD;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.record-date {
  font-size: 30rpx;
  color: #757575;
}

.record-symptoms {
  font-size: 30rpx;
  color: #757575;
  margin-top: 8rpx;
  display: block;
}

.record-detail {
  font-size: 30rpx;
  color: #757575;
  margin-top: 4rpx;
  display: block;
}

.empty-text {
  text-align: center;
  font-size: 36rpx;
  color: #757575;
  margin-top: 200rpx;
}
