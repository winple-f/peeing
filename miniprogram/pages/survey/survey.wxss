.container {
  padding: 32rpx;
  padding-bottom: 160rpx;
}

.step-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 24rpx;
  display: block;
}

.step-desc {
  font-size: 34rpx;
  color: #757575;
  margin-bottom: 32rpx;
  display: block;
}

.timepoint-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.timepoint-card.selected {
  border-color: #2196F3;
  background: #E3F2FD;
}

.timepoint-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #212121;
  display: block;
}

.timepoint-desc {
  font-size: 30rpx;
  color: #757575;
  margin-top: 8rpx;
  display: block;
}

.question-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 16rpx;
  margin-top: 24rpx;
  display: block;
}

.radio-group {
  margin-bottom: 32rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  font-size: 36rpx;
  color: #212121;
  border-bottom: 1rpx solid #E0E0E0;
}

.radio-item radio {
  transform: scale(1.2);
  margin-right: 20rpx;
}

.radio-group-horizontal {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}

.radio-item-h {
  flex: 1;
  min-width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  font-size: 30rpx;
  color: #212121;
}

.radio-item-h radio {
  margin-bottom: 8rpx;
  transform: scale(1.1);
}

.result-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.result-label {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  display: block;
}

.result-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #2196F3;
  margin-top: 8rpx;
  display: block;
}

.result-severity {
  font-size: 30rpx;
  color: #757575;
  margin-top: 8rpx;
  display: block;
}

.thanks {
  font-size: 34rpx;
  color: #757575;
  text-align: center;
  margin-top: 32rpx;
  display: block;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
}

.btn-prev {
  flex: 1;
  background: transparent;
  color: #2196F3;
  font-size: 36rpx;
  border: 2rpx solid #2196F3;
  border-radius: 12rpx;
  line-height: 1.5;
}

.btn-next {
  flex: 2;
  background: #2196F3;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
}
