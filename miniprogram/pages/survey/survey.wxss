.container {
  padding: 32rpx;
  padding-bottom: 160rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 32rpx;
  text-align: center;
}

.survey-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.survey-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.survey-card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #2196F3;
  margin-bottom: 8rpx;
}

.survey-card-desc {
  font-size: 30rpx;
  color: #616161;
  margin-bottom: 8rpx;
}

.survey-card-info {
  font-size: 26rpx;
  color: #9E9E9E;
}

.progress-bar {
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: #4CAF50;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 28rpx;
  color: #9E9E9E;
  margin-bottom: 32rpx;
}

.question-area {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.question-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  padding: 24rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 4rpx solid transparent;
}

.option-item.selected {
  background: #E8F5E9;
  border-color: #4CAF50;
}

.option-text {
  font-size: 36rpx;
  color: #424242;
}

.input-area {
  margin-top: 16rpx;
}

.number-input {
  width: 100%;
  height: 96rpx;
  font-size: 40rpx;
  border: 4rpx solid #4CAF50;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.nav-buttons {
  display: flex;
  gap: 16rpx;
}

.btn-prev {
  flex: 1;
  background: #E0E0E0;
  color: #616161;
  font-size: 36rpx;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
}

.btn-next,
.btn-submit {
  flex: 1;
  background: #4CAF50;
  color: #FFFFFF;
  font-size: 36rpx;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
}

.btn-next[disabled],
.btn-submit[disabled] {
  background: #C8E6C9;
  color: #FFFFFF;
}

.result-area {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 24rpx;
}

.result-score {
  font-size: 80rpx;
  font-weight: bold;
  color: #4CAF50;
  margin-bottom: 16rpx;
}

.result-label {
  font-size: 40rpx;
  color: #FF9800;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.result-desc {
  font-size: 30rpx;
  color: #616161;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.btn-back {
  background: #2196F3;
  color: #FFFFFF;
  font-size: 36rpx;
  border-radius: 12rpx;
  border: none;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.btn-redo {
  background: #E0E0E0;
  color: #616161;
  font-size: 36rpx;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
}
