<view class="container">
  <view wx:if="{{currentStep === 0}}" class="step">
    <text class="step-title">随访时间点</text>
    <text class="step-desc">请选择您当前的随访时间点</text>
    <view class="timepoint-card {{selectedTimePoint === 'T0基线' ? 'selected' : ''}}" bindtap="selectTimePoint" data-point="T0基线">
      <text class="timepoint-name">基线评估</text>
      <text class="timepoint-desc">开始治疗前的基础评估</text>
    </view>
    <view class="timepoint-card {{selectedTimePoint === 'T1（疗程后1月）' ? 'selected' : ''}}" bindtap="selectTimePoint" data-point="T1（疗程后1月）">
      <text class="timepoint-name">疗程后1个月</text>
      <text class="timepoint-desc">治疗结束1个月后</text>
    </view>
    <view class="timepoint-card {{selectedTimePoint === 'T2（疗程后3月）' ? 'selected' : ''}}" bindtap="selectTimePoint" data-point="T2（疗程后3月）">
      <text class="timepoint-name">疗程后3个月</text>
      <text class="timepoint-desc">治疗结束3个月后</text>
    </view>
    <view class="timepoint-card {{selectedTimePoint === 'T3（疗程后6月）' ? 'selected' : ''}}" bindtap="selectTimePoint" data-point="T3（疗程后6月）">
      <text class="timepoint-name">疗程后6个月</text>
      <text class="timepoint-desc">治疗结束6个月后</text>
    </view>
  </view>

  <view wx:if="{{currentStep === 1}}" class="step">
    <text class="step-title">尿失禁情况（ICIQ-SF）</text>
    <text class="question-text">1. 您多久会漏一次尿？</text>
    <radio-group bindchange="onIciqQ1" class="radio-group">
      <label class="radio-item" wx:for="{{iciqQ1Options}}" wx:key="*this">
        <radio value="{{index}}" checked="{{iciqQ1 === index}}" />
        <text>{{item}}</text>
      </label>
    </radio-group>
    <text class="question-text">2. 每次漏尿的量大概有多少？</text>
    <radio-group bindchange="onIciqQ2" class="radio-group">
      <label class="radio-item" wx:for="{{iciqQ2Options}}" wx:key="*this">
        <radio value="{{index}}" checked="{{iciqQ2 === index}}" />
        <text>{{item}}</text>
      </label>
    </radio-group>
    <text class="question-text">3. 漏尿对您的日常生活影响有多大？</text>
    <radio-group bindchange="onIciqQ3" class="radio-group">
      <label class="radio-item" wx:for="{{iciqQ3Options}}" wx:key="*this">
        <radio value="{{index}}" checked="{{iciqQ3 === index}}" />
        <text>{{item}}</text>
      </label>
    </radio-group>
  </view>

  <view wx:if="{{currentStep === 2}}" class="step">
    <text class="step-title">排尿症状（IPSS）</text>
    <text class="step-desc">请回忆过去1个月的情况，选择最符合的答案</text>
    <block wx:for="{{ipssQuestions}}" wx:key="index" wx:for-item="q" wx:for-index="qIdx">
      <text class="question-text">{{qIdx + 1}}. {{q.text}}</text>
      <radio-group bindchange="onIpssChange" data-idx="{{qIdx}}" class="radio-group-horizontal">
        <label class="radio-item-h" wx:for="{{q.options}}" wx:key="*this" wx:for-item="opt" wx:for-index="optIdx">
          <radio value="{{optIdx}}" checked="{{ipssAnswers[qIdx] === optIdx}}" />
          <text>{{opt}}</text>
        </label>
      </radio-group>
    </block>
  </view>

  <view wx:if="{{currentStep === 3}}" class="step">
    <text class="step-title">生活质量（QoL）</text>
    <text class="question-text">如果您以后的生活中，一直伴有现在的排尿情况，您觉得怎么样？</text>
    <radio-group bindchange="onQolChange" class="radio-group">
      <label class="radio-item" wx:for="{{qolOptions}}" wx:key="*this">
        <radio value="{{index}}" checked="{{qolScore === index}}" />
        <text>{{item}}</text>
      </label>
    </radio-group>
  </view>

  <view wx:if="{{currentStep === 4}}" class="step">
    <text class="step-title">您的评分</text>
    <view class="result-card">
      <text class="result-label">尿失禁评分（ICIQ-SF）</text>
      <text class="result-score">{{iciqTotalScore}} 分</text>
    </view>
    <view class="result-card">
      <text class="result-label">前列腺症状评分（IPSS）</text>
      <text class="result-score">{{ipssTotalScore}} 分</text>
      <text class="result-severity">症状程度：{{ipssSeverity}}</text>
    </view>
    <view class="result-card">
      <text class="result-label">生活质量评分（QoL）</text>
      <text class="result-score">{{qolScore}} 分</text>
    </view>
    <text class="thanks">感谢您的配合！数据已保存。</text>
  </view>

  <view class="bottom-bar">
    <button wx:if="{{currentStep > 0 && currentStep < 4}}" class="btn-prev" bindtap="goPrev">返回</button>
    <button class="btn-next" bindtap="goNext">{{currentStep < 4 ? '下一步' : '返回首页'}}</button>
  </view>
</view>
