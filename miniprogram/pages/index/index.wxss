.container {
  padding: 32rpx;
}

.header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.header-logo {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.welcome {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
}

.patient-number {
  font-size: 30rpx;
  color: #757575;
  margin-top: 4rpx;
}

.today-card {
  background: #2196F3;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.today-label {
  font-size: 34rpx;
  color: #FFFFFF;
}

.today-count {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-top: 8rpx;
}

.card-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.card-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 240rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-item-placeholder {
  flex: 1;
}

.card-icon {
  font-size: 56rpx;
  color: #2196F3;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #212121;
}

.btn-logout {
  width: 100%;
  background: transparent;
  color: #F44336;
  font-size: 36rpx;
  font-weight: bold;
  border: 2rpx solid #F44336;
  border-radius: 12rpx;
  line-height: 1.5;
  margin-top: 32rpx;
}
