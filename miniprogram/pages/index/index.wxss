.container {
  padding: 32rpx;
}

.header {
  margin-bottom: 32rpx;
}

.patient-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.patient-id {
  font-size: 30rpx;
  color: #2196F3;
  font-weight: bold;
}

.today-date {
  font-size: 28rpx;
  color: #757575;
}

.quick-record {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  text-align: center;
}

.quick-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 8rpx;
}

.quick-desc {
  font-size: 30rpx;
  color: #757575;
  margin-bottom: 32rpx;
}

.quick-btn {
  width: 100%;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-item {
  width: 48%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.icon-text {
  font-size: 40rpx;
  font-weight: bold;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 4rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #9E9E9E;
}

.followup-area {
  background: #E3F2FD;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 16rpx;
}

.followup-title {
  font-size: 30rpx;
  color: #2196F3;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.followup-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.followup-name {
  font-size: 34rpx;
  color: #212121;
  font-weight: bold;
}

.followup-date {
  font-size: 30rpx;
  color: #757575;
}
