<view class="container">
  <view class="header">
    <image class="header-logo" src="/assets/icon.png" mode="aspectFit"></image>
    <view class="header-text">
      <text class="welcome">{{welcomeText}}</text>
      <text class="patient-number">编号：{{patientId}}</text>
    </view>
  </view>

  <view class="today-card">
    <text class="today-label">今日排尿</text>
    <text class="today-count">{{todayCount}} 次</text>
  </view>

  <view class="card-row">
    <view class="card-item" bindtap="goRecord">
      <text class="card-icon">+</text>
      <text class="card-title">快速记录</text>
    </view>
    <view class="card-item" bindtap="goSurvey">
      <text class="card-icon">评</text>
      <text class="card-title">填写量表</text>
    </view>
  </view>

  <view class="card-row">
    <view class="card-item" bindtap="goHistory">
      <text class="card-icon">史</text>
      <text class="card-title">查看记录</text>
    </view>
    <view class="card-item" bindtap="goChart">
      <text class="card-icon">图</text>
      <text class="card-title">数据统计</text>
    </view>
  </view>

  <view class="card-row">
    <view class="card-item" bindtap="goExport">
      <text class="card-icon">出</text>
      <text class="card-title">导出数据</text>
    </view>
    <view class="card-item-placeholder"></view>
  </view>

  <button class="btn-logout" bindtap="handleLogout">退出登录</button>
</view>
