.container {
  display: flex;
  flex-direction: column;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: #F5F7FA;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 48rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.text-input {
  width: 100%;
  height: 96rpx;
  font-size: 36rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #E0E0E0;
}

.btn-register {
  width: 100%;
  background: #2196F3;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.login-row {
  display: flex;
  justify-content: center;
  align-items: center;
}

.has-account {
  font-size: 30rpx;
  color: #757575;
}

.login-link {
  font-size: 30rpx;
  color: #2196F3;
  font-weight: bold;
  margin-left: 8rpx;
}
