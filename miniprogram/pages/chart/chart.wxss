.container {
  padding: 32rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 16rpx;
  margin-top: 16rpx;
  display: block;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #2196F3;
}

.month-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
}

.week-row {
  display: flex;
  margin-bottom: 8rpx;
}

.week-label {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #757575;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
}

.day-cell.empty {
  visibility: hidden;
}

.day-number {
  font-size: 28rpx;
  color: #212121;
}

.day-score {
  font-size: 20rpx;
  color: #FFFFFF;
  margin-top: 2rpx;
}

.heatmap-hint {
  font-size: 26rpx;
  color: #757575;
  text-align: center;
  margin-top: 16rpx;
  display: block;
}

.chart-tabs {
  display: flex;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 34rpx;
  color: #757575;
}

.tab-item.active {
  color: #2196F3;
  font-weight: bold;
  border-bottom: 4rpx solid #2196F3;
}

.chart-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212121;
  text-align: center;
  margin-bottom: 24rpx;
  display: block;
}

.chart-area {
  display: flex;
  align-items: flex-end;
  height: 400rpx;
}

.y-axis {
  display: flex;
  flex-direction: column-reverse;
  justify-content: space-between;
  height: 320rpx;
  padding-right: 16rpx;
}

.y-label {
  font-size: 22rpx;
  color: #BDBDBD;
}

.line-chart {
  flex: 1;
}

.chart-line-container {
  height: 320rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  height: 320rpx;
  gap: 8rpx;
}

.chart-bar-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 320rpx;
}

.bar-value {
  font-size: 22rpx;
  color: #2196F3;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.chart-bar {
  width: 60%;
  background: linear-gradient(to top, #2196F3, #64B5F6);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
}

.bar-label {
  font-size: 22rpx;
  color: #757575;
  margin-top: 8rpx;
}

.chart-summary {
  font-size: 30rpx;
  color: #757575;
  text-align: center;
  margin-top: 16rpx;
  display: block;
}
