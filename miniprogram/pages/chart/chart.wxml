<view class="container">
  <text class="section-title">症状热力图</text>
  <view class="card">
    <view class="month-nav">
      <view class="nav-btn" bindtap="prevMonth"><text>＜</text></view>
      <text class="month-text">{{heatmapYear}}年{{heatmapMonth}}月</text>
      <view class="nav-btn" bindtap="nextMonth"><text>＞</text></view>
    </view>
    <view class="calendar">
      <view class="week-row">
        <text class="week-label">日</text>
        <text class="week-label">一</text>
        <text class="week-label">二</text>
        <text class="week-label">三</text>
        <text class="week-label">四</text>
        <text class="week-label">五</text>
        <text class="week-label">六</text>
      </view>
      <view class="day-grid">
        <view wx:for="{{calendarDays}}" wx:key="index" class="day-cell {{item.empty ? 'empty' : ''}}" style="background:{{item.color}}">
          <text wx:if="{{!item.empty}}" class="day-number">{{item.day}}</text>
          <text wx:if="{{!item.empty && item.score > 0}}" class="day-score">{{item.score}}</text>
        </view>
      </view>
    </view>
    <text class="heatmap-hint">颜色越深表示当日症状评分总和越高</text>
  </view>

  <text class="section-title">排尿次数</text>
  <view class="chart-tabs">
    <view class="tab-item {{chartTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">周统计</view>
    <view class="tab-item {{chartTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">月统计</view>
  </view>
  <view class="card">
    <text class="chart-title">{{chartTitle}}</text>
    <view class="chart-area">
      <view class="y-axis">
        <text class="y-label" wx:for="{{yLabels}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="line-chart">
        <view class="chart-line-container">
          <view class="chart-bars">
            <view wx:for="{{chartData}}" wx:key="index" class="chart-bar-group">
              <text class="bar-value">{{item.count}}</text>
              <view class="chart-bar" style="height:{{item.height}}rpx"></view>
              <text class="bar-label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <text class="chart-summary">{{chartSummary}}</text>
  </view>
</view>
